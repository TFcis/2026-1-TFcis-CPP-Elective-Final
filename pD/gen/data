# ------------------------------------------------------------------
# sub1: T has exactly 1 distinct char; that char appears in S exactly m times.
# Cover: tiny / small / medium / huge n, varied target chars (incl. ASCII 33 and 126),
# varied filler character ranges (full, thin, single).
@subtask sub1
gen single 10 1 65 33 126 s1-1
gen single 10 5 33 65 126 s1-2
gen single 100 50 90 33 126 s1-3
gen single 2000 1000 126 33 125 s1-4
gen single 1000000 1 65 33 126 s1-5
gen single 1000000 100000 65 33 126 s1-6
gen single 1000000 100000 100 33 126 s1-7
gen single 100000 100000 100 100 100 s1-8
gen single 1000000 100000 50 33 33 s1-9
gen single 1000000 100000 50 33 49 s1-10
# m near sqrt(n) -- balanced T-length vs interval-count regime.
gen single 1000000 1000 65 33 126 s1-11
gen single 1000000 3162 65 33 126 s1-12

# ------------------------------------------------------------------
# sub2: |T| = 2.
# Cover: T = "cc" (same), T = "cd" (different), extreme ASCII pair, narrow alphabet.
@subtask sub2
gen pair 10 1 65 66 33 126 s2-1
gen pair 10 0 65 65 33 126 s2-2
gen pair 1000000 1 33 126 33 126 s2-3
gen pair 1000000 1 65 66 33 126 s2-4
gen pair 1000000 1 65 66 65 66 s2-5
gen pair 1000000 0 65 65 33 126 s2-6
gen pair 1000000 0 65 65 65 65 s2-7
gen pair 1000000 1 33 126 33 126 s2-8
gen pair 1000000 1 80 81 80 81 s2-9
gen pair 1000000 0 50 50 50 50 s2-10
# Adversarial structural tests for the reset-r / early-break / prefilter family.
# S uses only c1='A' (65) and c2='B' (66) so prefilter cannot reduce np.
gen adv_sub2 1000000 1 65 66 a2-1
gen adv_sub2 1000000 2 65 66 a2-2
gen adv_sub2 1000000 3 65 66 a2-3
gen adv_sub2 1000000 4 65 66 a2-4
gen adv_sub2 1000000 5 65 66 a2-5

